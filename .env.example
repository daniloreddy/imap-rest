HOST=127.0.0.1
PORT=8000
DEV=false
# Fuso orario per i timestamp mostrati in dashboard (IANA tz name, es. Europe/Rome).
# I dati restano salvati come epoch UTC internamente — TZ regola solo il display.
TZ=UTC

AUTH_SECURE_COOKIE=0
TRUSTED_PROXIES=127.0.0.1

# Token bearer opzionale per gli endpoint IMAP/SMTP (comma-separated).
# Vuoto = endpoint aperti (solo uso locale/rete fidata) — impostalo prima di esporre il servizio.
API_TOKENS=

# Rate limit sugli endpoint API (sintassi slowapi, es. "20/minute"). Hot-reloadable
# (letto da ConfigManager a ogni richiesta, non serve restart per cambiarlo).
RATE_LIMIT=20/minute

# Auto-refresh pannelli dashboard — runtime-editable dalla pagina Impostazioni (hot-reload).
REFRESH_ENABLED=true
REFRESH_INTERVAL=5

# Retention log metriche (giorni) — purge automatico ogni 24h, hot-reloadable.
METRICS_RETENTION_DAYS=30

# Solo Docker: sposta lo storage utente di NiceGUI (tema dark/light, ecc.) dentro la
# directory dati bind-montata, altrimenti si azzera ad ogni ricreazione del container.
NICEGUI_STORAGE_PATH=/app/data/.nicegui

# --- Account IMAP/SMTP ---
# Ogni account "<nome>" richiede le variabili IMAP_<NOME>_* (e SMTP_<NOME>_* se si invia posta).
# Il nome account passato nelle richieste API viene uppercased automaticamente.

# IMAP account "danilo"
IMAP_DANILO_HOST=imap.example.com
IMAP_DANILO_PORT=993
IMAP_DANILO_USERNAME=danilo@example.com
IMAP_DANILO_PASSWORD=secret
IMAP_DANILO_SSL=true

# SMTP account "danilo"
SMTP_DANILO_HOST=smtp.example.com
SMTP_DANILO_PORT=587
SMTP_DANILO_USERNAME=danilo@example.com
SMTP_DANILO_PASSWORD=secret
SMTP_DANILO_STARTTLS=true
SMTP_DANILO_SSL=false
